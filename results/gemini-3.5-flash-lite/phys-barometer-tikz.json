   "source": "\\begin{tikzpicture}[font=\\sffamily, scale=0.85]\n\n  % Base (flat plate)\n  \\draw[thick] (0,0) rectangle (7,0.4);\n  \\surface{(0,0)}{(7,0)}{1}\n\n  % Bell jar\n  \\draw[thick] (1.5,0.4) \n    .. controls (1.5,0.4) and (1.5,2) .. (1.5,4)\n    .. controls (1.5,6.5) and (2.5,7) .. (3.5,7)\n    .. controls (4.5,7) and (5.5,6.5) .. (5.5,4)\n    .. controls (5.5,2) and (5.5,0.4) .. (5.5,0.4);\n\n  % Neck of bell jar at top\n  \\draw[thick] (3.1,7) -- (3.1,8.2);\n  \\draw[thick] (3.9,7) -- (3.9,8.2);\n  \n  % Cork/bung around tube at the top\n  \\fill[white] (3.1,7.5) rectangle (3.9,8.0);\n  \\draw[thick] (3.1,7.5) rectangle (3.9,8.0);\n  \\draw[thick] (3.1,7.5) -- (3.9,7.5);\n  \\draw[thick] (3.1,8.0) -- (3.9,8.0);\n\n  % Side pipe B near bottom left of bell jar (open ended stub with label B)\n  \\draw[thick] (1.5,1.2) -- (0.8,1.2);\n  \\draw[thick] (1.5,1.8) -- (0.8,1.8);\n  \\draw[thick] (0.8,1.2) arc (270:90:0.3);\n  \\node[left] at (0.8,1.5) {B};\n\n  % Dish of mercury inside bell jar\n  \\draw[thick] (2.5,0.4) -- (2.5,1.2) -- (4.5,1.2) -- (4.5,0.4);\n  % Mercury in dish\n  \\dotregion{2.52}{0.4}{4.48}{0.9}\n\n  % Glass tube (100 cm long) passing through top\n  \\draw[thick] (3.3,0.6) -- (3.3,9.2);\n  \\draw[thick] (3.7,0.6) -- (3.7,9.2);\n  \n  % Top connection A\n  \\draw[thick] (3.1,9.2) rectangle (3.9,9.6);\n  \\node at (3.5,9.4) {A};\n\n  % Pipe to vacuum pump from A\n  \\draw[thick] (3.5,9.6) -- (3.5,10.2) -- (5.5,10.2);\n  \\node[right] at (5.5,10.2) {to vacuum pump};\n\n  % Mercury column inside the tube (up to 760 mm level, y = 5.4)\n  \\dotregion{3.32}{0.6}{3.68}{5.4}\n\n  % Labels and arrows\n  % Glass tube label\n  \\draw[->, >=latex] (5.1,7.5) -- (3.7,7.5);\n  \\node[right] at (5.1,7.5) {glass tube 100 cm long};\n\n  % Bell jar label\n  \\draw[->, >=latex] (5.8,4.5) -- (5.3,4.5);\n  \\node[right] at (5.8,4.5) {bell jar};\n\n  % Mercury label\n  \\draw[->, >=latex] (2.2,0.7) -- (2.5,0.7);\n  \\node[left] at (2.2,0.7) {mercury};\n\n  % Point Y at the bottom of the tube inside the mercury\n  \\fill (3.5,0.8) circle (2pt);\n  \\node[below right] at (3.5,0.8) {Y};\n\n  % Dashed level lines for 760 mm\n  \\draw[dashed] (2.2,0.9) -- (4.8,0.9);\n  \\draw[dashed] (2.2,5.4) -- (4.8,5.4);\n\n  % Double headed arrow for 760 mm\n  \\draw[<->, >=latex] (4.6,0.9) -- node[right] {760 mm} (4.6,5.4);\n\n  % Caption\n  \\node at (3.5,-0.6) {Fig. 6.1};\n\n\\end{tikzpicture}",
