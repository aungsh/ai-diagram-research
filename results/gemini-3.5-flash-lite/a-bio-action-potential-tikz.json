   "source": "\\begin{tikzpicture}[font=\\sffamily, scale=1]\n    % Grid setup\n    \\draw[help lines, lightgray!50, step=0.5] (0,-2.5) grid (5.5,4);\n    \n    % Axes\n    \\draw[-latex, thick] (0,-2.5) -- (0,4.2) node[anchor=south] {membrane potential / mV};\n    \\draw[-latex, thick] (0,-2.5) -- (5.8,-2.5) node[anchor=west] {time / ms};\n    \n    % Y-axis ticks and labels\n    \\foreach \\y/\\v in {-2/-80, -1.5/-60, -1/-40, -0.5/-20, 0/0, 0.5/20, 1/40} {\n        \\draw (0,\\y) -- (-0.1,\\y);\n    }\n    \\node[anchor=east] at (0,-2) {$-80$};\n    \\node[anchor=east] at (0,-1.5) {$-60$};\n    \\node[anchor=east] at (0,-1) {$-40$};\n    \\node[anchor=east] at (0,-0.5) {$-20$};\n    \\node[anchor=east] at (0,0) {$0$};\n    \\node[anchor=east] at (0,0.5) {$+20$};\n    \\node[anchor=east] at (0,1) {$+40$};\n    \n    % Additional specific levels mentioned\n    \\node[anchor=east] at (0,-1.75) {$-70$};\n    \\draw[dashed, gray] (0,-1.75) -- (5.5,-1.75);\n\n    % Threshold line at -55 mV (-1.375 in coordinate)\n    \\draw[dashed, thick] (0,-1.375) -- (5.5,-1.375) node[anchor=west] {threshold};\n\n    % X-axis ticks\n    \\foreach \\x in {0, 1, 2, 3, 4, 5} {\n        \\draw (\\x,-2.5) -- (\\x,-2.6);\n        \\node[anchor=north] at (\\x,-2.6) {\\x};\n    }\n\n    % Action Potential curve\n    % Resting at -70 mV (-1.75) until ~0.8\n    % Rises sharply to +35 mV (~0.875) at 1.6 ms\n    % Falls quickly to -80 mV (-2) at 2.6 ms\n    % Recovers to -70 mV (-1.75) by 3.6 ms, stays flat.\n    \\draw[thick] plot[smooth, tension=0.7] coordinates {\n        (0,-1.75) \n        (0.8,-1.75) \n        (1.2,-0.5) \n        (1.6,0.875) \n        (2.0,0) \n        (2.4,-1.8) \n        (2.6,-2.0) \n        (3.0,-1.9) \n        (3.6,-1.75) \n        (5.0,-1.75)\n    };\n\n    % Labels with letters only pointing to specific features:\n    % A to rising phase\n    \\draw[thick, -latex] (1.3, 1.2) node[anchor=south west] {A} -- (1.1, -0.2);\n\n    % B to falling phase\n    \\draw[thick, -latex] (2.5, 0.5) node[anchor=south west] {B} -- (2.1, 0);\n\n    % C to dip below rest (hyperpolarization)\n    \\draw[thick, -latex] (2.9, -2.7) node[anchor=north west] {C} -- (2.65, -2.05);\n\n    % D to flat resting part after recovery\n    \\draw[thick, -latex] (4.5, -1.0) node[anchor=west] {D} -- (3.8, -1.75);\n\n    % Caption\n    \\node at (2.75,-3.5) {Fig. 9.1};\n\n\\end{tikzpicture}",
