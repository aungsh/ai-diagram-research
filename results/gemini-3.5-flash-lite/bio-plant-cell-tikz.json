   "source": "\\begin{tikzpicture}[font=\\sffamily, scale=1.2]\n\n  % Outer cell wall\n  \\draw[thick, rounded corners=12pt] (0,0) rectangle (3.5,4.5);\n  \n  % Inner cell membrane (just inside)\n  \\draw[thin, rounded corners=10pt] (0.1,0.1) coordinate (cm-bl) rectangle (3.4,4.4) coordinate (cm-tr);\n\n  % Cytoplasm shading / background\n  \\dotregion{0.12}{0.12}{3.38}{4.38}\n\n  % Large central vacuole (occupies most of the middle)\n  \\draw[thick, fill=white, rounded corners=8pt] (0.7,0.7) coordinate (vac-bl) rectangle (2.8,3.2) coordinate (vac-tr);\n\n  % Nucleus near the top, pressed to one side\n  \\draw[thick, fill=white] (2.2,3.7) ellipse (0.45 and 0.3);\n  % Nucleolus\n  \\fill (2.2,3.7) circle (0.12);\n\n  % Chloroplasts (about 10 ovals scattered in the cytoplasm)\n  \\foreach \\pos in {\n    (0.5, 2.0), (0.4, 3.0), (0.6, 4.0), \n    (1.5, 4.1), (3.0, 3.8), (3.1, 2.5), \n    (3.2, 1.5), (2.8, 0.4), (1.5, 0.4), (0.5, 1.0)\n  } {\n    \\draw[thick, fill=gray!30] \\pos ellipse (0.22 and 0.12);\n  }\n\n  % Label lines and letters (A to E)\n  % A: cell wall (pointing to outer boundary)\n  \\draw[-latex, thick] (-1.2, 3.8) node[left] {A} -- (0, 3.8);\n\n  % B: cell membrane (pointing just inside wall)\n  \\draw[-latex, thick] (-1.2, 3.1) node[left] {B} -- (0.12, 3.1);\n\n  % C: chloroplast\n  \\draw[-latex, thick] (-1.2, 2.0) node[left] {C} -- (0.5, 2.0);\n\n  % D: nucleus\n  \\draw[-latex, thick] (3.8, 3.9) node[right] {D} -- (2.6, 3.8);\n\n  % E: vacuole\n  \\draw[-latex, thick] (3.8, 2.0) node[right] {E} -- (2.5, 2.0);\n\n  % Caption\n  \\node at (1.75, -0.6) {Fig. 1.1};\n\n\\end{tikzpicture}",
