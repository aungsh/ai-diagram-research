   "source": "\\begin{tikzpicture}[font=\\sffamily, thick, scale=1]\n  % Circuit using standard TikZ\n  \n  % Battery on the left (closed loop properly connected)\n  \\draw (0,0) -- (0,0.5) -- (-0.5,0.5)\n        (-0.4,0.5) -- (0.4,0.5)\n        (-0.2,0.9) -- (0.2,0.9)\n        (-0.4,1.3) -- (0.4,1.3)\n        (-0.2,1.7) -- (0.2,1.7)\n        (0,1.7) -- (0,2.5) -- (4,2.5);\n        \n  \\draw (0,0) -- (8,0); % Complete bottom rail\n\n  \\node[left] at (-0.5, 1.1) {12\\,V};\n\n  % Resistor R (zigzag)\n  \\draw (4,2.5) -- (4.3,2.5) \n        -- (4.5,2.8) -- (4.9,2.2) -- (5.3,2.8) -- (5.7,2.2) -- (6.1,2.8) -- (6.5,2.2) \n        -- (6.7,2.5) -- (8,2.5);\n  \\node[above] at (5.5, 2.9) {$R$ (2.0\\,k$\\Omega$)};\n\n  % Thermistor T (box with diagonal arrow)\n  \\draw (8,0) -- (8,0.7);\n  \\draw (7.7,0.7) rectangle (8.3,1.3);\n  \\draw (7.8,0.8) -- (8.2,1.2);\n  \\draw (7.8,1.2) -- (8.0,1.2) -- (8.0,1.0); % arrowhead part\n  \\draw (8,1.3) -- (8,2.5);\n  \\node[right] at (8.3, 1.0) {$T$};\n\n  % Voltmeter across R\n  \\draw (4.5,2.5) -- (4.5,3.6) -- (7.5,3.6) -- (7.5,2.5);\n  \\draw (6,3.6) circle (0.3);\n  \\node at (6,3.6) {V};\n\n  % Figure label below\n  \\node at (4,-0.8) {Fig. 2.1};\n\\end{tikzpicture}",
