   "source": "\\begin{tikzpicture}[font=\\sffamily, scale=0.85, every node/.style={transform shape}]\n    % Stand and clamp parts\n    \\draw[thick] (0,0) -- (0,5.5);\n    \\draw[thick] (-0.3,4.5) -- (0,4.5);\n    \\draw[thick] (0,4.3) -- (1.5,4.3);\n\n    % Tripod stand over Bunsen burner\n    \\draw[thick] (1.3,1.8) -- (3.1,1.8); % wire gauze top\n    \\draw[thick] (1.5,1.8) -- (1.2,0);   % left leg\n    \\draw[thick] (2.9,1.8) -- (3.2,0);   % right leg\n    \\draw[thick] (2.2,1.8) -- (2.2,0);   % back leg (visual)\n\n    % Bunsen burner\n    \\draw[thick] (2.2,0.6) ellipse (0.35 and 0.12);\n    \\draw[thick] (1.85,0) rectangle (2.55,0.6);\n    % Burner collar & air hole\n    \\draw[thick] (1.95,0.3) rectangle (2.45,0.45);\n    \\fill[black] (2.15,0.375) rectangle (2.25,0.425);\n    % Barrel\n    \\draw[thick] (2.05,0.6) -- (2.05,1.2) (2.35,0.6) -- (2.35,1.2);\n    \n    % Flame\n    \\draw[thin, fill=gray!30] (2.2,1.2) .. controls (2.0,1.5) and (2.05,1.7) .. (2.2,1.9) .. controls (2.35,1.7) and (2.4,1.5) .. (2.2,1.2);\n    \\draw[thin, fill=white] (2.2,1.25) .. controls (2.1,1.45) and (2.12,1.55) .. (2.2,1.7) .. controls (2.28,1.55) and (2.3,1.45) .. (2.2,1.25);\n\n    % Round bottom flask\n    \\draw[thick] (2.2,3.2) circle (1.2);\n    \n    % Liquid inside flask (sea water) - clean white background behind text to ensure readability\n    \\dotregion{1.1}{2.0}{3.3}{2.9}\n    \\fill[white] (1.6,2.3) rectangle (2.8,2.7);\n    \\node at (2.2,2.5) {sea water};\n\n    % Cork / Bung at top of flask\n    \\draw[thick, fill=white] (1.9,4.2) rectangle (2.5,4.6);\n\n    % Thermometer\n    \\draw[thick] (2.2,3.8) -- (2.2,6.2);\n    \\draw[thick] (2.2,6.2) circle (0.08);\n    \n    % Thermometer label pointing properly to the thermometer stem/top\n    \\draw[->, thick] (1.2,5.5) node[left] {thermometer} -- (2.2,5.8);\n\n    % Bulb level with side arm indicator\n    \\draw[dashed, thin] (2.2,4.3) -- (3.2,4.3);\n\n    % Liebig condenser (Apparatus X)\n    % Outer jacket\n    \\draw[thick] (3.2,4.3) -- (7.5,1.5);\n    \\draw[thick] (3.6,3.9) -- (7.9,1.1);\n    % Inner tube\n    \\draw[thick] (3.2,4.1) -- (7.5,1.3);\n    \\draw[thick] (3.2,3.7) -- (7.5,0.9);\n    \n    % Ends of condenser\n    \\draw[thick] (3.2,4.3) arc (90:270:0.3 and 0.2);\n    \\draw[thick] (7.5,1.5) arc (0:-180:0.43 and 0.2);\n\n    % Water in and out connections\n    % Lower end (Water in)\n    \\draw[thick] (6.9,1.1) -- (6.9,0.4);\n    \\draw[thick] (7.1,1.2) -- (7.1,0.4);\n    \\fill[black] (7.0,0.4) circle (0.05);\n    \\node[below] at (7.0,0.4) {water in};\n    \n    % Upper end (Water out)\n    \\draw[thick] (3.8,3.7) -- (3.8,4.5);\n    \\draw[thick] (3.6,3.6) -- (3.6,4.5);\n    \\fill[black] (3.7,4.5) circle (0.05);\n    \\node[above] at (3.7,4.5) {water out};\n\n    % Connecting neck from flask to condenser\n    \\draw[thick] (2.8,4.2) -- (3.5,4.2);\n    \\draw[thick] (2.8,3.8) -- (3.3,3.8);\n\n    % Receiver flask (conical flask)\n    \\draw[thick] (7.2,0.5) -- (7.8,-1.5) -- (8.8,-1.5) -- (9.4,0.5) -- cycle;\n    \\draw[thick] (7.8,0.5) arc (180:360:0.8 and 0.15);\n    \\draw[thick] (7.5,-1.5) -- (9.1,-1.5); % base\n    \n    % Pure water inside\n    \\dotregion{7.5}{-1.0}{9.1}{-1.5}\n    \\fill[white] (7.8,-1.4) rectangle (8.8,-1.0);\n    \\node at (8.3,-1.2) {pure water};\n\n    % Adapter between condenser and receiver\n    \\draw[thick] (7.3,1.3) -- (7.8,0.7) -- (8.1,0.7);\n    \\draw[thick] (7.1,0.9) -- (7.6,0.3) -- (7.9,0.3);\n\n    % Cork for receiver flask\n    \\draw[thick, fill=white] (7.9,0.4) rectangle (8.7,0.7);\n\n    % Label for X\n    \\draw[->, thick] (5.8,2.1) -- (6.3,2.9);\n    \\node[above right] at (6.3,2.9) {X};\n\n    % Figure caption\n    \\node at (5,-2.5) {Fig. 4.1};\n\\end{tikzpicture}",
