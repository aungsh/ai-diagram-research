   "source": "\\begin{tikzpicture}[font=\\sffamily, scale=1.2]\n\n    % Draw the phospholipid bilayer\n    % Top layer hydrophilic heads and tails\n    \\foreach \\x in {0, 0.4, ..., 7.2} {\n        \\draw[thick] (\\x, 1.8) circle (0.15);\n        \\draw[thick] (\\x, 1.65) -- (\\x, 1.1);\n        \\draw[thick] (\\x+0.1, 1.65) -- (\\x+0.1, 1.1);\n    }\n    % Bottom layer hydrophilic heads and tails\n    \\foreach \\x in {0, 0.4, ..., 7.2} {\n        \\draw[thick] (\\x, 0.2) circle (0.15);\n        \\draw[thick] (\\x, 0.35) -- (\\x, 0.9);\n        \\draw[thick] (\\x+0.1, 0.35) -- (\\x+0.1, 0.9);\n    }\n\n    % Standard fluid/kinked tails for realism (unsaturated fatty acids)\n    \\draw[thick] (1.6, 1.65) -- (1.5, 1.3) -- (1.7, 1.1);\n    \\draw[thick] (1.7, 1.65) -- (1.6, 1.3) -- (1.8, 1.1);\n    \n    \\draw[thick] (4.4, 0.35) -- (4.5, 0.7) -- (4.3, 0.9);\n    \\draw[thick] (4.5, 0.35) -- (4.6, 0.7) -- (4.4, 0.9);\n\n    % Protein C (Channel protein - transmembrane)\n    \\fill[white] (2.4, 0.1) rectangle (3.2, 1.9);\n    \\draw[thick] (2.4, 0.2) arc (180:360:0.1) -- (2.6, 1.8) arc (180:0:0.1) -- cycle;\n    \\draw[thick] (3.0, 0.2) arc (180:360:0.1) -- (3.2, 1.8) arc (180:0:0.1);\n    % Inner channel pore\n    \\draw[thick, dashed] (2.8, 0.2) -- (2.8, 1.8);\n\n    % Protein B (Globular / Integral protein)\n    \\fill[white] (5.2, 0.5) rectangle (6.2, 1.9);\n    \\draw[thick, rounded corners=6pt] (5.2, 0.8) rectangle (6.2, 1.8);\n\n    % Cholesterol (D) tucked between phospholipids\n    \\begin{scope}[shift={(3.8, 1.0)}, rotate=30]\n        \\draw[thick, fill=white] (0,0) rectangle (0.4, 0.8);\n        \\draw[thick] (0.2, 0.8) -- (0.2, 1.1);\n    \\end{scope}\n\n    % Glycoprotein / Glycolipid (E) on top of protein B\n    \\draw[thick, -] (5.7, 1.8) -- (5.7, 2.1);\n    \\draw[thick] (5.7, 2.1) circle (0.08);\n    \\draw[thick] (5.75, 2.15) circle (0.08);\n    \\draw[thick] (5.65, 2.2) circle (0.08);\n\n    % Labels with pointers\n    % A: Phospholipid (pointing to