   "source": "\\begin{tikzpicture}[font=\\sffamily, scale=1.0]\n  % Beaker\n  \\draw[thick] (1,0) -- (1,4) -- (2,4); % left wall, top rim left\n  \\draw[thick] (5,0) -- (5,4) -- (4,4); % right wall, top rim right\n  \\draw[thick] (1,0) -- (5,0); % bottom\n  \n  % Liquid in beaker (distilled water)\n  \\dotregion{1.02}{0.02}{4.98}{3.0}\n  \n  % Water level line\n  \\draw[dashed] (1,3) -- (5,3) node[right, font=\\footnotesize] {Distilled water};\n\n  % Visking tubing bag (semi-permeable membrane) submerged in water\n  % Represented as a rounded sac hanging from the stopper/capillary\n  \\draw[thick, fill=white] (2.7,1.8) -- (3.3,1.8) -- (3.5,0.8) .. controls (3.5,0.2) and (2.5,0.2) .. (2.5,0.8) -- (2.7,1.8);\n  \n  % Concentrated sucrose solution inside Visking tubing\n  % We can hatch or shade the inside of the bag slightly, or leave it clear with label\n  \\node[font=\\footnotesize, align=center] at (3,1.1) {Concentrated\\\\sucrose\\\\solution};\n\n  % Rubber bung / stopper at top of beaker closing it (optional, but standard)\n  \\draw[thick, fill=gray!30] (2.5,4.2) rectangle (3.5,3.8);\n  \n  % Capillary tube passing through bung\n  \\draw[thick] (2.9,3.5) -- (2.9,5.5);\n  \\draw[thick] (3.1,3.5) -- (3.1,5.5);\n  \n  % Liquid level inside capillary tube\n  \\draw[fill=black!50] (2.91,3.8) rectangle (3.09,4.8);\n  \n  % Arrow pointing to liquid level\n  \\draw[-latex] (4.2,4.8) -- (3.1,4.8);\n  \\node[right, font=\\footnotesize] at (4.2,4.8) {Liquid level};\n\n  % Labels and pointers\n  \\draw[-latex] (0.5,2.0) -- (2.5,1.5);\n  \\node[left, font=\\footnotesize, align=right] at (0.5,2.0) {Visking tubing\\\\(semi-permeable\\\\membrane)};\n\n  % Figure caption\n  \\node[font=\\small, align=center] at (3,-0.8) {Fig. 2.1};\n\\end{tikzpicture}",
